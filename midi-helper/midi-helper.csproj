<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenControl.MidiHelper</RootNamespace>
    <AssemblyName>midi-helper</AssemblyName>
    
    <!-- Single file publish settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <!-- Suppress trimming warnings for WinRT -->
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    
    <!-- Allow unsafe code for WinRT interop -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Windows MIDI Services SDK - Reference DLLs directly from installed SDK -->
  <PropertyGroup>
    <WmsSdkPath>C:\Program Files\Windows MIDI Services\PowerShell\WindowsMidiServices</WmsSdkPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMS .NET Projection -->
    <Reference Include="Microsoft.Windows.Devices.Midi2.NetProjection">
      <HintPath>$(WmsSdkPath)\Microsoft.Windows.Devices.Midi2.NetProjection.dll</HintPath>
      <Private>true</Private>
    </Reference>
    
    <!-- Windows SDK .NET (for WinRT types) -->
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>$(WmsSdkPath)\Microsoft.Windows.SDK.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    
    <!-- WinRT Runtime -->
    <Reference Include="WinRT.Runtime">
      <HintPath>$(WmsSdkPath)\WinRT.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
